const http=require('http'),fs=require('fs'),path=require('path'),crypto=require('crypto');
const PORT=process.env.PORT||3000,KEY=process.env.GEMINI_API_KEY,OWNER=process.env.OWNER_CODE||'',MODEL=process.env.MODEL||'gemini-2.5-flash';
const DB=path.join(process.env.DATA_DIR||__dirname,'data.json');
let db={users:{},sessions:{},cfg:{title:'Yala.ia',accent:'#7c5cff',css:'',
 plans:[{id:'free',name:'Gratis',price:0,chats:10,images:2,docs:1},{id:'basic',name:'Básico',price:5,chats:100,images:20,docs:10},{id:'pro',name:'Pro',price:12,chats:500,images:100,docs:50}],
 codes:[{code:'BIENVENIDO',percent:20}]}};
try{db=Object.assign(db,JSON.parse(fs.readFileSync(DB,'utf8')))}catch(e){}
const save=()=>fs.writeFile(DB,JSON.stringify(db),()=>{});
const today=()=>new Date().toISOString().slice(0,10);
const cookies=r=>Object.fromEntries((r.headers.cookie||'').split(';').map(c=>c.trim().split('=')).filter(c=>c[0]));
const send=(res,c,o)=>{res.writeHead(c,{'Content-Type':'application/json'});res.end(JSON.stringify(o))};
const body=r=>new Promise(ok=>{let d='';r.on('data',c=>{d+=c;if(d.length>2e5)r.destroy()});r.on('end',()=>{try{ok(JSON.parse(d||'{}'))}catch(e){ok({})}})});
const hits={};
function who(req,res){const c=cookies(req);let id=c.yid;const set=[];
 if(!id||!/^[a-f0-9]{32}$/.test(id)){id=crypto.randomBytes(16).toString('hex');set.push(`yid=${id}; Path=/; Max-Age=31536000; HttpOnly; SameSite=Lax`)}
 if(set.length)res.setHeader('Set-Cookie',set);
 const u=db.users[id]||(db.users[id]={plan:'free',pct:0,day:today(),chats:0,images:0,docs:0});
 if(u.day!==today())Object.assign(u,{day:today(),chats:0,images:0,docs:0});
 const owner=!!(c.oid&&db.sessions[c.oid]);return{id,u,owner}}
const plan=u=>db.cfg.plans.find(p=>p.id===u.plan)||db.cfg.plans[0];
const pub=()=>({title:db.cfg.title,accent:db.cfg.accent,css:db.cfg.css,plans:db.cfg.plans});
async function claude(system,messages,max=2000){
 const r=await fetch('https://generativelanguage.googleapis.com/v1beta/models/'+MODEL+':generateContent',{method:'POST',headers:{'x-goog-api-key':KEY,'content-type':'application/json'},body:JSON.stringify({systemInstruction:{parts:[{text:system}]},contents:messages.map(m=>({role:m.role==='assistant'?'model':'user',parts:[{text:m.content}]})),generationConfig:{maxOutputTokens:max*3}})});
 const j=await r.json();if(!r.ok)throw new Error(j.error?.message||'API error');
 const t=(j.candidates?.[0]?.content?.parts||[]).map(p=>p.text||'').join('');if(!t)throw new Error('La IA no devolvió respuesta, inténtalo de nuevo.');return t}
const clean=s=>String(s||'').slice(0,4000);
function quota(w,kind){if(w.owner)return true;const p=plan(w.u);if(w.u[kind]>=p[kind])return false;w.u[kind]++;save();return true}
const SYS='Eres Yala.ia, un asistente de IA amable y útil. Responde en el idioma del usuario.';
http.createServer(async(req,res)=>{try{
 const url=req.url.split('?')[0];
 if(req.method==='GET'&&!url.startsWith('/api/')){const f=fs.readFileSync(path.join(__dirname,'index.html'));res.writeHead(200,{'Content-Type':'text/html; charset=utf-8'});return res.end(f)}
 const w=who(req,res),k=w.id,now=Date.now();hits[k]=(hits[k]||[]).filter(t=>now-t<60000);if(hits[k].push(now)>30)return send(res,429,{error:'Demasiadas peticiones, espera un momento.'});
 const b=req.method==='POST'?await body(req):{};
 if(url==='/api/state'){const p=plan(w.u);return send(res,200,{cfg:pub(),me:{plan:p.id,pct:w.u.pct,chats:w.u.chats,images:w.u.images,docs:w.u.docs,owner:w.owner}})}
 if(url==='/api/owner/login'){const a=Buffer.from(String(b.code||'')),o=Buffer.from(OWNER);
  if(!OWNER||a.length!==o.length||!crypto.timingSafeEqual(a,o))return send(res,401,{error:'Código incorrecto'});
  const t=crypto.randomBytes(24).toString('hex');db.sessions[t]=1;save();res.setHeader('Set-Cookie',`oid=${t}; Path=/; Max-Age=2592000; HttpOnly; SameSite=Lax`);return send(res,200,{ok:1})}
 if(url.startsWith('/api/owner/')){if(!w.owner)return send(res,403,{error:'Solo el dueño'});
  if(url==='/api/owner/cfg'&&!req.method.match(/POST/))return send(res,200,{cfg:db.cfg,users:Object.keys(db.users).length});
  if(url==='/api/owner/cfg'){if(!b.cfg||!Array.isArray(b.cfg.plans)||!Array.isArray(b.cfg.codes))return send(res,400,{error:'Config no válida'});db.cfg=b.cfg;save();return send(res,200,{ok:1})}
  if(url==='/api/owner/ai'){const t=await claude('Editas la configuración JSON de una app. Devuelve SOLO el JSON completo, sin markdown.',[{role:'user',content:'Config actual: '+JSON.stringify(db.cfg)+'\nClaves: title, accent (hex), css (CSS extra; clases: .card,button,body), plans [{id,name,price,chats,images,docs}] (límites diarios), codes [{code,percent,plan?}] (plan opcional: lo activa al canjear). Instrucción: '+clean(b.instruction)}],3000);
   try{const n=JSON.parse(t.replace(/```json|```/g,'').trim());if(!Array.isArray(n.plans)||!Array.isArray(n.codes))throw 0;db.cfg=n;save();return send(res,200,{cfg:n})}catch(e){return send(res,400,{error:'No pude aplicar el cambio'})}}}
 if(url==='/api/redeem'){const c=db.cfg.codes.find(x=>x.code.toLowerCase()===String(b.code||'').trim().toLowerCase());if(!c)return send(res,404,{error:'Código no válido'});
  if(c.plan&&db.cfg.plans.some(p=>p.id===c.plan))w.u.plan=c.plan;if(c.percent)w.u.pct=c.percent;save();return send(res,200,{ok:1,percent:c.percent||0,plan:c.plan||null})}
 if(url==='/api/plan'){const p=db.cfg.plans.find(x=>x.id===b.id);if(!p)return send(res,404,{error:'Plan no existe'});
  if(p.price*(1-(w.u.pct||0)/100)>0&&!w.owner)return send(res,402,{error:'Pago no conectado todavía. Usa un código de plan o contacta con el dueño.'});
  w.u.plan=p.id;save();return send(res,200,{ok:1})}
 if(!KEY)return send(res,500,{error:'Falta GEMINI_API_KEY en el servidor'});
 if(url==='/api/chat'){if(!quota(w,'chats'))return send(res,402,{error:'Has llegado al límite diario de tu plan.'});
  const m=(Array.isArray(b.messages)?b.messages:[]).slice(-20).map(x=>({role:x.role==='assistant'?'assistant':'user',content:clean(x.content)}));
  if(!m.length||m[m.length-1].role!=='user')return send(res,400,{error:'Mensaje vacío'});return send(res,200,{reply:await claude(SYS,m,1500)})}
 if(url==='/api/image'){if(!quota(w,'images'))return send(res,402,{error:'Has llegado al límite diario de imágenes de tu plan.'});
  const t=await claude('Eres un ilustrador. Respondes SOLO con código SVG válido.',[{role:'user',content:'Ilustración artística y vistosa para: "'+clean(b.prompt)+'". Solo <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">…</svg>, con degradados y formas, sin scripts ni imágenes externas.'}],3500);
  const m=t.match(/<svg[\s\S]*<\/svg>/i);if(!m)return send(res,500,{error:'No se pudo crear la imagen'});
  return send(res,200,{svg:m[0].replace(/<script[\s\S]*?<\/script>/gi,'').replace(/\son\w+\s*=\s*("[^"]*"|'[^']*')/gi,'').replace(/<foreignObject[\s\S]*?<\/foreignObject>/gi,'')})}
 if(url==='/api/doc'){if(!quota(w,'docs'))return send(res,402,{error:'Has llegado al límite diario de documentos de tu plan.'});
  return send(res,200,{text:await claude('Redactas documentos completos y bien estructurados en texto plano. Primera línea: el título. Usa "# " para encabezados y "- " para listas. Sin markdown adicional.',[{role:'user',content:'Crea este documento: '+clean(b.prompt)}],3500)})}
 send(res,404,{error:'No encontrado'})}catch(e){try{send(res,500,{error:String(e.message||e)})}catch(x){}}}).listen(PORT,()=>console.log('Yala.ia en puerto '+PORT));

