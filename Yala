document.querySelectorAll('.tabs button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tabs button').forEach(x=>x.className='g');b.className='';['c','i','d','p','o'].forEach(t=>$('#'+t).hidden=t!==b.dataset.t)});
function add(r,t){const d=document.createElement('div');d.className='m '+(r==='user'?'u':'a');d.textContent=t;$('#log').append(d);d.scrollIntoView()}
const chat=()=>run(async()=>{const t=$('#ci').value.trim();if(!t)return;$('#ci').value='';hist.push({role:'user',content:t});add('user',t);const r=await api('chat',{messages:hist});hist.push({role:'assistant',content:r.reply});add('assistant',r.reply);load()});
$('#cs').onclick=chat;$('#ci').onkeydown=e=>{if(e.key==='Enter')chat()};
$('#ig').onclick=()=>run(async()=>{$('#io').textContent='Creando...';try{const r=await api('image',{prompt:$('#ip').value});$('#io').innerHTML='<div class="img">'+r.svg+'</div>';load()}catch(e){$('#io').textContent='';throw e}});
$('#dg').onclick=()=>run(async()=>{$('#do').textContent='Escribiendo...';try{const r=await api('doc',{prompt:$('#dp').value});doc=r.text;$('#do').innerHTML='<pre></pre><div class="row"><button id="pdf">Descargar PDF</button><button class="g" id="txt">Descargar TXT</button></div>';$('#do pre').textContent=doc;
$('#pdf').onclick=()=>{const d=new jspdf.jsPDF(),W=180;let y=20;doc.split('\n').forEach(l=>{const h=l.startsWith('#');const s=l.replace(/^#+\s*/,'');d.setFont('helvetica',h?'bold':'normal');d.setFontSize(h?15:11);d.splitTextToSize(s,W).forEach(x=>{if(y>280){d.addPage();y=20}d.text(x,15,y);y+=h?8:6})});d.save('documento.pdf')};
$('#txt').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([doc]));a.download='documento.txt';a.click()};load()}catch(e){$('#do').textContent='';throw e}});
$('#pl').onclick=e=>{const id=e.target.dataset.p;if(id)run(async()=>{await api('plan',{id});await load()})};
$('#ca').onclick=()=>run(async()=>{const r=await api('redeem',{code:$('#cd').value});$('#cd').value='';await load();$('#er').style.color='inherit';$('#er').textContent='Código aplicado'});
$('#ob').onclick=()=>run(async()=>{await api('owner/login',{code:$('#oc').value});await load()});
$('#oa').onclick=()=>run(async()=>{$('#om').textContent='Aplicando...';await api('owner/ai',{instruction:$('#oi').value});$('#oi').value='';await load();$('#om').textContent='Cambios guardados'});
$('#os').onclick=()=>run(async()=>{await api('owner/cfg',{cfg:JSON.parse($('#oj').value)});await load();$('#om').textContent='Guardado'});
load();
</script></body></html>

