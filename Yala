  const m=(Array.isArray(b.messages)?b.messages:[]).slice(-20).map(x=>({role:x.role==='assistant'?'assistant':'user',content:clean(x.content)}));
  if(!m.length||m[m.length-1].role!=='user')return send(res,400,{error:'Mensaje vacío'});return send(res,200,{reply:await claude(SYS,m,1500)})}
